# Copie ce fichier en ~/Noter/.env

# Clé API Claude (obligatoire pour les résumés)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude et niveau d'effort (low | medium | high)
NOTER_CLAUDE_MODEL=claude-opus-5-5
NOTER_CLAUDE_EFFORT=medium

# Whisper : tiny | base | small | medium | large-v3 | large-v3-turbo
NOTER_WHISPER_MODEL=large-v3
# Forcer la langue (fr, en…) — vide = auto-détection
# NOTER_WHISPER_LANGUAGE=fr

# Résumer automatiquement après transcription
# Apparence : auto (suit macOS), light ou dark
NOTER_THEME=auto
NOTER_AUTO_SUMMARIZE=true
# Créer une carte (premier board, liste « À faire ») pour chaque action à la fin d'un résumé
NOTER_AUTO_TASKS=true

# Diarisation (qui parle) — nécessite pip install 'noter[diarize]' et HF_TOKEN
NOTER_DIARIZE=false
# HF_TOKEN=hf_...

# Emplacements (défaut : ~/Noter)
# NOTER_DATA_DIR=~/Noter/recordings
# NOTER_DB_PATH=~/Noter/noter.db

# Serveur MCP (`noter mcp install` pour Claude Desktop / Claude Code)
# Seulement les outils de lecture (recherche, comptes-rendus, boards)
NOTER_MCP_READ_ONLY=false
# Outils de suppression (enregistrements, cartes) — toujours avec confirmation
NOTER_MCP_ALLOW_DELETE=false
# Démarrer / arrêter un enregistrement depuis Claude (passe par Noter.app)
NOTER_MCP_ALLOW_RECORD=true
# Lancer Noter.app si besoin (traitement d'un job, enregistrement)
NOTER_MCP_LAUNCH_APP=true
